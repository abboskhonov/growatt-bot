{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "growatt-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-04",
  "alias": {
    "bun:sqlite": "./src/stubs/bun-sqlite.ts"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
  },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "growatt-bot",
      "database_id": "ec292436-9785-445e-9019-80a23beb0199"
    }
  ],
  // "ai": {
  //   "binding": "AI"
  // },
  // "observability": {
  //   "enabled": true,
  //   "head_sampling_rate": 1
  // }
}